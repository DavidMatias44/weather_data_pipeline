  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n\tdate_day,\n\tforecast_t_minus_2,\n\tforecast_t_minus_1,\n\tcurrent_forecast\nFROM (\n\tSELECT\n\t\tdate_day,\n\t\tLAG(min_temperature, 2) OVER(PARTITION BY date_day ORDER BY is_current) AS forecast_t_minus_2,\n\t\tLAG(min_temperature, 1) OVER(PARTITION BY date_day ORDER BY is_current) AS forecast_t_minus_1,\n\t\tmin_temperature AS current_forecast,\n\t\tis_current\n\tFROM wdp.week_weather_report\n) AS t1\nWHERE is_current = 1;",
        "lib/type": "mbql.stage/native"
      }
    ]
  },
