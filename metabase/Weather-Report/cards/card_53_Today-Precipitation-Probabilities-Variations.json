  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT\n\thour_,\n\tforecast_t_minus_2,\n\tforecast_t_minus_1,\n\tcurrent_forecast\nFROM (\n\tSELECT\n\t\thour_,\n\t\tLAG(precip_prob, 2) OVER(PARTITION BY hour_ ORDER BY valid_to) AS forecast_t_minus_2,\n\t\tLAG(precip_prob, 1) OVER(PARTITION BY hour_ ORDER BY valid_to) AS forecast_t_minus_1,\n\t\tprecip_prob AS current_forecast,\n\t\tis_current\n\tFROM wdp.today_weather_report\n) AS t1\nWHERE is_current = 1;"
      }
    ]
  },
