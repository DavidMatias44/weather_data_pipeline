    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT\n\tCONCAT(temperature, '°C')\nFROM wdp.today_weather_report\nWHERE hour_ < TO_CHAR((CURRENT_TIMESTAMP AT TIME ZONE 'America/Denver'), 'HH24:MI')\nORDER BY hour_ DESC\nLIMIT 1;"
